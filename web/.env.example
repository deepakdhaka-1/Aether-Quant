NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# 32 bytes base64 — must equal engine/.env AETHER_ENCRYPTION_KEY
AETHER_ENCRYPTION_KEY=
ENGINE_URL=http://localhost:8000
ENGINE_API_TOKEN=
NEXT_PUBLIC_HL_NETWORK=mainnet
# Your builder wallet (revenue). Must hold >= 100 USDC in Hyperliquid perps.
NEXT_PUBLIC_BUILDER_ADDRESS=0x42A8B8e6f960D399DeB81c5C103b6313f828d06F
# Max fee users approve. Actual fee per order is engine BUILDER_FEE_BPS10 (must be <= this).
NEXT_PUBLIC_BUILDER_MAX_FEE=0.05%
