# --- App database (new Aether Quant Supabase project) — SERVICE ROLE, server only ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Market data: CoinGlass for US-equity OHLCV (commodities use Hyperliquid candles) ---
COINGLASS_BASE_URL=https://fapi.coinglass.com
COINGLASS_API_KEY=              # optional; the kline endpoint used today needs no key

# Same value as web/.env AETHER_ENCRYPTION_KEY  (generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
AETHER_ENCRYPTION_KEY=

# Shared secret between web and engine API
ENGINE_API_TOKEN=

# --- Hyperliquid ---
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HIP3_DEX=xyz
HYPERLIQUID_SLIPPAGE=0.005
# Builder code = your revenue. The builder wallet must hold >= 100 USDC in perps.
BUILDER_ADDRESS=0xYOUR_BUILDER_WALLET
BUILDER_FEE_BPS10=30            # 30 = 0.03% per fill. Users approve a max of 0.05% in the app.

# --- Live gates: BOTH must be flipped to place real orders ---
DRY_RUN=true
HYPERLIQUID_LIVE_CONFIRMED=false

# --- Offline model (OpenAI-compatible: Ollama / LM Studio / llama.cpp / vLLM) ---
OFFLINE_MODEL_URL=http://localhost:11434/v1
OFFLINE_MODEL_NAME=qwen2.5:14b
