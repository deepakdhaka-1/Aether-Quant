# Monitor (engine/aether/monitor.py). Load alongside engine/.env. All optional:
# with no channel set, alerts are only logged and findings still land in heartbeats['monitor'].

# Telegram: bot from @BotFather. Comma list of chat ids (DM ids and group ids; supergroups are -100...).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Generic webhook (Slack incoming webhook, Discord /slack endpoint, PagerDuty bridge...). POST {"text","findings"}.
MONITOR_WEBHOOK_URL=
# Dead-man's switch: GET on every successful pass (e.g. healthchecks.io). Alerts YOU if the monitor dies.
MONITOR_PING_URL=
# Re-alert cooldown for the same finding, seconds (default 30 min).
MONITOR_ALERT_COOLDOWN_S=1800
# Prefix shown in alerts, e.g. prod / testnet.
MONITOR_ENV_LABEL=
# 1 = exit code 2 when a crit finding exists (default off).
MONITOR_FAIL_ON_CRIT=0
