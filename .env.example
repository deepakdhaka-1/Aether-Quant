# Shared local config for the web app, research engine, and optional deploy scripts.
# Copy this file to .env at the repository root. Keep .env private and never commit it.

# Supabase public client settings for the website
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Base64 DER SubjectPublicKeyInfo for the executor's RSA-OAEP/SHA-256 public key.
# This public key is safe to ship to browsers. Keep its matching private key only in the executor.
NEXT_PUBLIC_AGENT_ENCRYPTION_PUBLIC_KEY=

# Trusted executor only. Never configure this service-role key in the website deployment.
SUPABASE_SERVICE_ROLE_KEY=

# Shared web / engine API
ENGINE_URL=http://localhost:8000
ENGINE_API_TOKEN=

# Hyperliquid builder fee: 30 tenths of a basis point = 0.03% charged per fill.
NEXT_PUBLIC_HL_NETWORK=mainnet
NEXT_PUBLIC_BUILDER_ADDRESS=0x42A8B8e6f960D399DeB81c5C103b6313f828d06F
NEXT_PUBLIC_BUILDER_MAX_FEE=0.03%
BUILDER_ADDRESS=0x42A8B8e6f960D399DeB81c5C103b6313f828d06F
BUILDER_FEE_BPS10=30
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HIP3_DEX=xyz
HYPERLIQUID_SLIPPAGE=0.003

# Engine defaults and safety gates
DRY_RUN=true
HYPERLIQUID_LIVE_CONFIRMED=false
COINGLASS_BASE_URL=https://fapi.coinglass.com
COINGLASS_API_KEY=
OFFLINE_MODEL_URL=http://localhost:11434/v1
OFFLINE_MODEL_NAME=qwen2.5:14b

# Optional monitor notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
MONITOR_WEBHOOK_URL=
MONITOR_PING_URL=
MONITOR_ALERT_COOLDOWN_S=1800
MONITOR_ENV_LABEL=local
MONITOR_FAIL_ON_CRIT=0
